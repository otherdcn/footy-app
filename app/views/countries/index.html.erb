<% if user_signed_in? %>
  <p>Hi <%= current_user.username %> </p>

  <%= button_to "Sign out", destroy_user_session_path, method: :delete %>
  <%= link_to "Edit profile", edit_user_registration_path %>
<% else %>
  <%= link_to "Sign in", new_user_session_path %>
  <%= link_to "Sign up", new_user_registration_path %>
<% end %>

<h1>Footballing Countries</h1>
<p>Check one of the <%= @countries.size %> countries to view their leagues and club teams!</p>

<div class="countries">
  <% if @countries %>
    <% @countries.each_with_index do |country, idx| %>
      <div class="country">
        <p>
          <%= country["name"] %> (<%= country["code"] %>) |
          <%= image_tag(country["flag"],
                        size: "25", 
                        alt: "<#{country["name"]}> flag") if country["flag"] 
                        %>
          <%= link_to "View Country", country_path(idx) %>
        </p>
      </div>
    <% end %>
  <% else %>
    <p>No data available</p>
  <% end %>
</div>
